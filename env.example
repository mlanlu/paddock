# Secrets for one profile. Lives at ~/.config/paddock/env/<profile>.env —
# outside every repo, never mounted, passed to the container as environment.
# Nothing from ~/.claude, ~/.config/gh or ~/.ssh is ever mounted.

# GitHub: a FINE-GRAINED PAT scoped to the repo(s) this profile covers
# (Contents: RW, Issues: RW, Pull requests: RW, Metadata: R).
# https://github.com/settings/personal-access-tokens/new
GH_TOKEN=

# Claude Code: `claude setup-token` on the host and paste the result, or leave
# empty and log in once inside the container (persists on its volume).
CLAUDE_CODE_OAUTH_TOKEN=

# Anything else the project needs, e.g. for openmatch:
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
